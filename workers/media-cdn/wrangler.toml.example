name = "chatcase-media-cdn"
main = "worker.mjs"
compatibility_date = "2026-05-20"

workers_dev = false

routes = [
  { pattern = "media.example.com", custom_domain = true }
]

[[r2_buckets]]
binding = "MEDIA_BUCKET"
bucket_name = "chatcase-uploads"
preview_bucket_name = "chatcase-uploads-dev"

[vars]
MEDIA_CDN_R2_KEY_PREFIX = "prod"
MEDIA_CDN_CACHE_TTL_SECONDS = "300"
MEDIA_CDN_ALLOWED_ORIGIN = "https://app.example.com"
