# Copy to .env and fill the real values locally or on the VPS.
# Never commit .env.

EXTERNAL_BASE_URL=http://localhost:8081
EXTERNAL_MQTT_BASE_URL=
PROXY_HTTP_BIND=8081

# Local default keeps uploads in Mongo GridFS unless R2 is explicitly enabled.
FILE_STORAGE_DRIVER=gridfs

# Conversation uploads.
# 209715200 = 200 MiB. Use */* to let the backend accept any extension.
MAX_UPLOAD_FILE_SIZE=209715200
CHAT_FILES_ALLOW_LIST=*/*
ASSETS_FILES_ALLOW_LIST=*/*
CASEZAP_MEDIA_MAX_BYTES=209715200
CHATCASE_AUTO_ASSIGN_SOLE_AGENT=true

# Local MongoDB URIs. Production should use authenticated URIs.
TILEDESK_MONGODB_URI=mongodb://mongo/tiledesk
TILEDESK_LOGS_MONGODB_URI=mongodb://mongo/tiledesk-logs
CHAT21_MONGODB_URI=mongodb://mongo/chat21

# RabbitMQ local/dev credentials.
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=change-me
RABBITMQ_ERLANG_COOKIE=change-me-cookie
RABBITMQ_MANAGEMENT_URL=http://rabbitmq:15672/api
RABBITMQ_MANAGEMENT_USERNAME=admin
RABBITMQ_MANAGEMENT_PASSWORD=change-me
OPERATIONAL_RABBITMQ_QUEUES=jobsmanager,webhooks,messages,logs_queue,conversation-tags_queue,persist,tiledesk-trainer
OPERATIONAL_QUEUE_READY_ALERT_THRESHOLD=100
OPERATIONAL_QUEUE_UNACKED_ALERT_THRESHOLD=100
OPERATIONAL_MONITOR_ENABLED=true
OPERATIONAL_MONITOR_INTERVAL_SECONDS=300
OPERATIONAL_MONITOR_START_DELAY_SECONDS=60
OPERATIONAL_ALERT_MIN_SEVERITY=critical
OPERATIONAL_ALERT_WEBHOOK_URL=
OPERATIONAL_ALERT_WEBHOOK_EVENTS=alert.opened,alert.reopened,alert.still_open
OPERATIONAL_ALERT_WEBHOOK_TIMEOUT_MS=5000
OPERATIONAL_ALERT_NOTIFY_RESOLVED=false
OPERATIONAL_ALERT_EMAIL_ENABLED=false
OPERATIONAL_ALERT_EMAIL_TO=

# chat21/chat21-rabbitmq validates AMQP clients with JWT/OAuth tokens.
# RABBITMQ_DEFAULT_* secures the management user, but app containers need AMQP token URLs.
# Local docker-compose.yml has compatible dev defaults. To make them explicit, run:
# node scripts/generate-rabbitmq-jwt.js tokenKey rabbitmq
AMQP_MANAGER_URL=
RABBITMQ_URI=
RABBITMQ_ADMIN_URI=

# Dev defaults are kept by docker-compose.yml for compatibility.
# Use strong values in production.
CHAT21_JWT_SECRET=tokenKey
JWT_SECRET_KEY=tokenKey
APPS_ACCESS_TOKEN_SECRET=nodeauthsecret
GPTKEY=CHANGEIT
CHAT21_ADMIN_TOKEN=
PUSH_WH_CHAT21_API_ADMIN_TOKEN=
PUSH_WH_WEBHOOK_TOKEN=

# Admin and Meta/WhatsApp configuration.
ADMIN_EMAIL=redacted@example.invalid
SUPER_ADMIN_EMAILS=redacted@example.invalid
FB_APP_ID=
FB_APP_SECRET=
REDACTED_SECRET
VERIFY_TOKEN=chatcase_verify_2026

# CasePay integration.
CASEPAY_API_KEY=
REDACTED_SECRET
CASEPAY_WEBHOOK_SECRET=

# Cloudflare R2 for application uploads and conversation attachments.
# Use a bucket/key dedicated to uploads.
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_BUCKET=chatcase-uploads
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
R2_KEY_PREFIX=uploads/dev
OPERATIONAL_STORAGE_CHECK_ENABLED=true
OPERATIONAL_STORAGE_CHECK_TTL_SECONDS=300

# Cloudflare R2 for Mongo backup archives.
# Use a separate bucket/key from application uploads when possible.
MONGO_BACKUP_R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
MONGO_BACKUP_R2_BUCKET=chatcase-backups
MONGO_BACKUP_R2_ACCESS_KEY_ID=
MONGO_BACKUP_R2_SECRET_ACCESS_KEY=
MONGO_BACKUP_R2_REGION=auto
MONGO_BACKUP_R2_PREFIX=backups/mongo
MONGO_BACKUP_R2_RETENTION_DAILY=7
MONGO_BACKUP_R2_RETENTION_WEEKLY=4
MONGO_BACKUP_R2_RETENTION_MONTHLY=6

# Backup job options.
BACKUP_ALERT_WEBHOOK_URL=
BACKUP_ALERT_ON_SUCCESS=false
SKIP_RESTORE_CHECK=false
