[Unit]
Description=ChatCase MongoDB backup to Cloudflare R2 with restore check
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=-/etc/chatcase/chatcase-backup.env
ExecStart=/usr/bin/env bash -lc 'project_root="${PROJECT_ROOT:-/opt/chatcase/tiledesk}"; cd "$project_root"; exec "$project_root/scripts/chatcase-mongo-backup-r2-daily.sh"'
TimeoutStartSec=2h
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

[Install]
WantedBy=multi-user.target
