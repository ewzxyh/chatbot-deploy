# Copy to /etc/chatcase/chatcase-backup.env on the VPS.
# Keep this file permission-restricted: chmod 600 /etc/chatcase/chatcase-backup.env

PROJECT_ROOT=/opt/chatcase/tiledesk

MONGO_SERVICE=mongo
MONGO_DATABASES=tiledesk,chat21,tiledesk-logs
MONGO_RESTORE_SUFFIX=restore-test

MONGO_BACKUP_DIR=/var/backups/chatcase/mongo
MONGO_R2_DOWNLOAD_DIR=/var/backups/chatcase/mongo-r2-download-test
MONGO_BACKUP_LOG_DIR=/var/log/chatcase/backups

# Cloudflare R2 bucket used only for Mongo backup archives.
MONGO_BACKUP_R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
MONGO_BACKUP_R2_BUCKET=chatcase-backups
MONGO_BACKUP_R2_ACCESS_KEY_ID=<backup_access_key_id>
MONGO_BACKUP_R2_SECRET_ACCESS_KEY=<backup_secret_access_key>
MONGO_BACKUP_R2_REGION=auto
MONGO_BACKUP_R2_PREFIX=backups/mongo
MONGO_BACKUP_R2_RETENTION_DAILY=7
MONGO_BACKUP_R2_RETENTION_WEEKLY=4
MONGO_BACKUP_R2_RETENTION_MONTHLY=6

# Cloudflare R2 bucket used by tiledesk-server for uploads and conversation attachments.
# These variables are consumed by docker-compose when FILE_STORAGE_DRIVER=r2.
FILE_STORAGE_DRIVER=r2
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_BUCKET=chatcase-uploads
R2_ACCESS_KEY_ID=<uploads_access_key_id>
R2_SECRET_ACCESS_KEY=<uploads_secret_access_key>
R2_REGION=auto
R2_KEY_PREFIX=prod

# Optional alert endpoint. Supports common JSON webhooks.
BACKUP_ALERT_WEBHOOK_URL=
BACKUP_ALERT_ON_SUCCESS=false

# Set true only if restore-check is too heavy for a very small VPS.
SKIP_RESTORE_CHECK=false
