# Copy to .env.production on the VPS and fill every CHANGE_ME value.
# Never commit the real .env.production file.

EXTERNAL_BASE_URL=https://app.example.com
COMMUNITY_PUBLIC_URL=https://chatcase.com.br/community/
EXTERNAL_MQTT_BASE_URL=wss://app.example.com
PROXY_HTTP_BIND=80
TZ=America/Sao_Paulo
CHATCASE_DEFAULT_TIMEZONE=America/Sao_Paulo

# Use R2 for production uploads.
FILE_STORAGE_DRIVER=r2
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_BUCKET=chatcase-uploads
R2_ACCESS_KEY_ID=CHANGE_ME
R2_SECRET_ACCESS_KEY=CHANGE_ME
R2_REGION=auto
R2_KEY_PREFIX=prod
OPERATIONAL_STORAGE_CHECK_ENABLED=true
OPERATIONAL_STORAGE_CHECK_TTL_SECONDS=300

# Optional Cloudflare Worker CDN for private R2 media.
# The Worker must use the same bucket and key prefix as R2_BUCKET/R2_KEY_PREFIX.
MEDIA_CDN_ENABLED=false
MEDIA_CDN_BASE_URL=https://media.example.com
MEDIA_CDN_SIGNING_SECRET=REDACTED_SECRET
MEDIA_CDN_DEFAULT_TTL_SECONDS=604800
MEDIA_CDN_REPLACE_SRC=true

# Conversation uploads.
# 209715200 = 200 MiB. Use */* to accept any extension in dashboard/chat uploads.
MAX_UPLOAD_FILE_SIZE=209715200
CHAT_FILES_ALLOW_LIST=*/*
ASSETS_FILES_ALLOW_LIST=*/*
CASEZAP_MEDIA_MAX_BYTES=209715200
CHATCASE_AUTO_ASSIGN_SOLE_AGENT=true
WABA_TEMPLATE_PUBLICATION_TIMEOUT_MS=30000

# Sleekplan feedback/changelog widget.
CHATCASE_ENABLE_SLEEKPLAN=false
CHATCASE_SLEEKPLAN_PRODUCT_ID=
CHATCASE_SLEEKPLAN_SCRIPT_URL=
CHATCASE_SLEEKPLAN_SSO_BASE_URL=

# Privacy/LGPD controls.
# Keep audit long enough for support/security review; reduce only with a clear legal policy.
AUDIT_EVENT_RETENTION_DAYS=365
PRIVACY_CONVERSATION_RETENTION_DAYS=1095
PRIVACY_ATTACHMENT_RETENTION_DAYS=1095
PRIVACY_LEAD_RETENTION_DAYS=1095
PRIVACY_RETENTION_BATCH_LIMIT=500
PRIVACY_RETENTION_ATTACHMENT_BATCH_LIMIT=500
PRIVACY_RETENTION_DELETE_ATTACHMENTS=true
PRIVACY_RETENTION_JOB_ENABLED=false
PRIVACY_RETENTION_JOB_DRY_RUN=true
PRIVACY_RETENTION_JOB_INTERVAL_HOURS=24
PRIVACY_RETENTION_JOB_START_DELAY_SECONDS=300
PRIVACY_EXPORT_MAX_REQUESTS=100
PRIVACY_EXPORT_MAX_MESSAGES=500
PRIVACY_ANONYMIZE_MESSAGE_TEXT=true

# Mongo with auth. Root is only for initialization/administration; app services use dedicated users.
# Use URL-safe passwords below because they are embedded in MongoDB connection strings.
MONGO_INITDB_ROOT_USERNAME=chatcase_root
MONGO_INITDB_ROOT_PASSWORD=REDACTED_SECRET
MONGO_TILEDESK_USERNAME=chatcase_tiledesk
MONGO_TILEDESK_PASSWORD=REDACTED_SECRET
MONGO_LOGS_USERNAME=chatcase_logs
MONGO_LOGS_PASSWORD=REDACTED_SECRET
MONGO_CHAT21_USERNAME=chatcase_chat21
MONGO_CHAT21_PASSWORD=REDACTED_SECRET
TILEDESK_MONGODB_URI=[REDACTED_CREDENTIAL_URL]
TILEDESK_LOGS_MONGODB_URI=[REDACTED_CREDENTIAL_URL]
CHAT21_MONGODB_URI=[REDACTED_CREDENTIAL_URL]

# Redis cache/dedup. Use a URL-safe random value so it can also be used in REDIS_URL.
REDIS_PASSWORD=REDACTED_SECRET
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379

# RabbitMQ.
RABBITMQ_DEFAULT_USER=chatcase
RABBITMQ_DEFAULT_PASS=CHANGE_ME_STRONG_PASSWORD
RABBITMQ_ERLANG_COOKIE=CHANGE_ME_LONG_RANDOM_COOKIE
RABBITMQ_MANAGEMENT_URL=http://rabbitmq:15672/api
RABBITMQ_MANAGEMENT_USERNAME=chatcase
RABBITMQ_MANAGEMENT_PASSWORD=REDACTED_SECRET
OPERATIONAL_RABBITMQ_QUEUES=jobsmanager,webhooks,messages,logs_queue,conversation-tags_queue,persist,tiledesk-trainer
OPERATIONAL_QUEUE_READY_ALERT_THRESHOLD=100
OPERATIONAL_QUEUE_UNACKED_ALERT_THRESHOLD=100
OPERATIONAL_MONITOR_ENABLED=true
OPERATIONAL_MONITOR_INTERVAL_SECONDS=300
OPERATIONAL_MONITOR_START_DELAY_SECONDS=60

# Configure at least one operational alert destination before production:
# 1. webhook, recommended for n8n/Discord/Slack/incident service; or
# 2. e-mail, using SMTP below.
OPERATIONAL_ALERT_MIN_SEVERITY=critical
OPERATIONAL_ALERT_WEBHOOK_URL=https://app.example.com/automation/webhooks/chatcase/operational-alert?secret=REDACTED_SECRET
OPERATIONAL_ALERT_WEBHOOK_EVENTS=alert.opened,alert.reopened
OPERATIONAL_ALERT_WEBHOOK_TIMEOUT_MS=5000
OPERATIONAL_ALERT_NOTIFY_RESOLVED=false
OPERATIONAL_ALERT_EMAIL_ENABLED=false
OPERATIONAL_ALERT_EMAIL_TO=redacted@example.invalid

# Optional Sentry backend error capture.
# Create a Node/Express project in Sentry and paste the DSN here.
# Keep disabled until DSN and data-scrubbing rules are reviewed.
SENTRY_ENABLED=false
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_SERVER_NAME=chatcase-vps-1

# Optional Sentry frontend error capture for /dashboard/.
# Create a Browser/Angular project in Sentry or reuse the same DSN only if data-scrubbing is acceptable.
DASHBOARD_SENTRY_ENABLED=false
DASHBOARD_SENTRY_DSN=
DASHBOARD_SENTRY_ENVIRONMENT=production
DASHBOARD_SENTRY_RELEASE=
DASHBOARD_SENTRY_TRACES_SAMPLE_RATE=0

# Optional: post-deploy smoke test credentials. Used only by scripts/production-smoke.js.
# Prefer exporting SMOKE_ADMIN_PASSWORD in the shell instead of storing it in this file.
SMOKE_BASE_URL=
SMOKE_ADMIN_EMAIL=
SMOKE_ADMIN_PASSWORD=
REDACTED_SECRET
SMOKE_DASHBOARD_PATH=/dashboard/
SMOKE_COMMUNITY_PATH=/community/
SMOKE_TIMEOUT_MS=15000
SMOKE_PUBLIC_ONLY=false
SMOKE_TEST_ALERT_NOTIFICATION=false
SMOKE_TEST_SENTRY=false

# Optional incident automation webhook.
# Decision for the first production cut: use this built-in dry-run receiver before adding n8n.
# Sentry issue alerts should point to:
# https://app.example.com/automation/webhooks/sentry/issue-alert?secret=REDACTED_SECRET
# Keep DRY_RUN=true until the endpoint URL and secret are configured behind HTTPS.
INCIDENT_AUTOMATION_PORT=8787
INCIDENT_AUTOMATION_DRY_RUN=true
INCIDENT_WEBHOOK_SECRET=REDACTED_SECRET
INCIDENT_MIN_SEVERITY=critical
INCIDENT_EMAIL_FROM=redacted@example.invalid
INCIDENT_EMAIL_TO=redacted@example.invalid

# Generate RabbitMQ token URLs with CHAT21_JWT_SECRET:
# node scripts/generate-rabbitmq-jwt.js CHANGE_ME_LONG_RANDOM_CHAT21_JWT_SECRET rabbitmq
AMQP_MANAGER_URL=CHANGE_ME_AMQP_MANAGER_URL
RABBITMQ_URI=CHANGE_ME_RABBITMQ_USER_URI
RABBITMQ_ADMIN_URI=CHANGE_ME_RABBITMQ_ADMIN_URI

# Application secrets. Generate separate long random values unless noted otherwise.
# CHAT21_JWT_SECRET must match the RabbitMQ JWT secret; docker-compose.yml wires it into RabbitMQ.
GLOBAL_SECRET=REDACTED_SECRET
CHAT21_JWT_SECRET=REDACTED_SECRET
# Optional explicit RabbitMQ JWT secret. If set, it must stay equal to CHAT21_JWT_SECRET.
RABBITMQ_JWT_SECRET=REDACTED_SECRET
JWT_SECRET_KEY=CHANGE_ME_LONG_RANDOM_INTERNAL_JWT_SECRET
# Must match GLOBAL_SECRET so the apps module can validate dashboard user JWTs.
APPS_ACCESS_TOKEN_SECRET=REDACTED_SECRET
SESSION_SECRET=REDACTED_SECRET

# AI/Knowledge Base/RAG provider.
# Keep AI_FEATURES_ENABLED=false when you are not using OpenAI/provider-backed features.
# If set to true, GPTKEY is required by scripts/check-production-env.js.
AI_FEATURES_ENABLED=false
GPTKEY=

# Activity history is enabled by default. Set to false to disable archiving.
ACTIVITY_HISTORY_ENABLED=true

# Internal chat tokens.
CHAT21_ADMIN_TOKEN=CHANGE_ME_CHAT21_ADMIN_TOKEN
PUSH_WH_CHAT21_API_ADMIN_TOKEN=CHANGE_ME_PUSH_API_ADMIN_TOKEN
PUSH_WH_WEBHOOK_TOKEN=CHANGE_ME_PUSH_WEBHOOK_TOKEN

# Super admin and WhatsApp/Meta app.
ADMIN_EMAIL=redacted@example.invalid
ADMIN_PASSWORD=REDACTED_SECRET
SUPER_PASSWORD=REDACTED_SECRET
SUPER_ADMIN_EMAILS=redacted@example.invalid
FB_APP_ID=CHANGE_ME
FB_APP_SECRET=CHANGE_ME
META_CONFIGURATION_ID=CHANGE_ME
VERIFY_TOKEN=CHANGE_ME_LONG_RANDOM_VERIFY_TOKEN

# SMTP.
EMAIL_ENABLED=true
EMAIL_HOST=smtp.example.com
EMAIL_USERNAME=CHANGE_ME
EMAIL_PASSWORD=CHANGE_ME
EMAIL_SECURE=true
EMAIL_PORT=465
EMAIL_FROM_ADDRESS=redacted@example.invalid

# CasePay.
CASEPAY_API_KEY=CHANGE_ME
CASEPAY_CONNECTION_ID=CHANGE_ME
CASEPAY_WEBHOOK_SECRET=CHANGE_ME

# Billing lifecycle automation.
# First production cut: enable the job only after CasePay webhooks, SMTP and admin review are validated.
BILLING_LIFECYCLE_JOB_ENABLED=false
BILLING_LIFECYCLE_JOB_DRY_RUN=true
BILLING_LIFECYCLE_DRY_RUN=true
BILLING_LIFECYCLE_JOB_INTERVAL_HOURS=24
BILLING_LIFECYCLE_JOB_START_DELAY_SECONDS=300
BILLING_LIFECYCLE_BATCH_LIMIT=100
BILLING_GRACE_DAYS=3
BILLING_SUSPEND_AFTER_DAYS=7
BILLING_DOWNGRADE_AFTER_DAYS=30
BILLING_DUNNING_NOTICE_INTERVAL_HOURS=24
BILLING_EXPIRING_NOTICE_DAYS=3
BILLING_LIFECYCLE_EMAIL_ENABLED=true

# Mongo backup archives in a separate private R2 bucket.
MONGO_BACKUP_R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
MONGO_BACKUP_R2_BUCKET=chatcase-backups
MONGO_BACKUP_R2_ACCESS_KEY_ID=CHANGE_ME
MONGO_BACKUP_R2_SECRET_ACCESS_KEY=CHANGE_ME
MONGO_BACKUP_R2_REGION=auto
MONGO_BACKUP_R2_PREFIX=backups/mongo
MONGO_BACKUP_R2_RETENTION_DAILY=7
MONGO_BACKUP_R2_RETENTION_WEEKLY=4
MONGO_BACKUP_R2_RETENTION_MONTHLY=6

BACKUP_ALERT_WEBHOOK_URL=
BACKUP_ALERT_ON_SUCCESS=false
SKIP_RESTORE_CHECK=false
